default.pgo
bin/
*.exe
.tectonix/session-baseline.json
training/checkpoints/
training/data/**/*.jsonl
**/__pycache__/

# Local training data / experiment artifacts (huge, never commit)
training/experiments/

# Rotating local model artifacts (bootstrap reference model stays tracked)
models/*.onnx
!models/gofer-9x9-bootstrap.onnx

# Secrets / local AWS (never commit)
.tectonix/*.pem
.tectonix/*-key.json
.tectonix/lightsail-key.json
*.pem

# Local reports / profiles (not release artifacts)
.tectonix/reports/*
!.tectonix/reports/bench-regression.json
# Tracked so the strength baseline the paper cites is reviewable, and so a
# regression in it shows up as a diff (it recorded a search bug for months).
!.tectonix/reports/arena-9x9-baseline.json
train-v3.log

# Pipeline v4 run dirs (state, shards, checkpoints) and local champion registry
# binaries; published bests live in GitHub Releases. index.json/cards stay trackable.
runs/
models/champions/*.onnx
.gofer-env
.venv/
.tectonix/artifacts/
